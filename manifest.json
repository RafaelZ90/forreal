{
  "manifest_version": 3,
  "name": "Unspin – the feed decoder",
  "short_name": "Unspin",
  "version": "0.1.0",
  "description": "Decodes LinkedIn, X and Bluesky posts into one honest line, collapses the fluff and points you to what's actually worth reading.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Unspin",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://bsky.app/*"
  ],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://x.com/*", "https://twitter.com/*", "https://bsky.app/*"],
      "js": ["src/defaults.js", "src/content/classifier.js", "src/content/sites.js", "src/content/overlay.js", "src/content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
